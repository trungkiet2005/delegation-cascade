paper-amc/b[0-9].log
paper-amc/build[0-9].log
paper-amc/bib.log

# The submission source archive carries the resolved bibliography, so retain
# these generated files even though other LaTeX intermediates stay ignored.
!paper-amc/main.bbl
!paper-amc/supplement.bbl

# Deterministic upload archives and their checksum manifests are local release
# outputs, not inputs. Ignoring the whole directory avoids a circular release
# workflow: committing a checksum changes the commit recorded inside the
# reproducibility archive and therefore changes that checksum again.
paper-amc/submission-artifacts/

results/figure_log*.txt

# Internal working notes, not published
paper/citation_audit_*.md
paper/refs_suggested_additions.bib
paper-amc/SUBMISSION_NOTES.md

# Publisher template packages, downloaded not authored
els-cas-templates.zip

# The typeset manuscript is not published here.  The journals are told that no
# part of the paper has appeared before, and a downloadable PDF in a public
# repository is the one thing that could be read against that, so the built
# manuscript stays local while the code, data and figures that reproduce it
# stay public.  Remove these lines once the paper is accepted.
paper/main.pdf
paper-*/main.pdf
paper-*/supplement.pdf
